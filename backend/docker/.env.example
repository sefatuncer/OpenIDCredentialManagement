# AI Agent Identity System - Docker Environment Variables

# Node environment
NODE_ENV=production

# PostgreSQL Configuration
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=change-this-password-in-production
POSTGRES_DB=ai_identity

# Wallet encryption keys (change in production!)
WALLET_KEY=your-secure-wallet-key-here

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# API Key for authentication
API_KEY=change-this-api-key-in-production

# API Configuration
API_PORT=3000

# Agent Ports
ISSUER_PORT=3001
VERIFIER_PORT=3002
HOLDER_PORT=3003

# Optional: External URLs (for production with reverse proxy)
# ISSUER_EXTERNAL_URL=https://issuer.example.com
# VERIFIER_EXTERNAL_URL=https://verifier.example.com
# HOLDER_EXTERNAL_URL=https://holder.example.com
# API_EXTERNAL_URL=https://api.example.com
