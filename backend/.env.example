# Application
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000

# All agents run on the same backend server
# API_BASE_URL is used for credential offer/verification URLs
API_BASE_URL=http://localhost:3000

# Issuer Agent
ISSUER_AGENT_NAME=AI-Agent-Issuer
ISSUER_WALLET_ID=issuer-wallet
ISSUER_WALLET_KEY=issuer-secure-key-change-in-production
# ISSUER_ENDPOINT - defaults to ${API_BASE_URL}/api/v1/issuer

# Verifier Agent
VERIFIER_AGENT_NAME=AI-Agent-Verifier
VERIFIER_WALLET_ID=verifier-wallet
VERIFIER_WALLET_KEY=verifier-secure-key-change-in-production
# VERIFIER_ENDPOINT - defaults to ${API_BASE_URL}/api/v1/verifier

# Holder Agent (AI Agent)
HOLDER_AGENT_NAME=AI-Agent-Holder
HOLDER_WALLET_ID=holder-wallet
HOLDER_WALLET_KEY=holder-secure-key-change-in-production
# HOLDER_ENDPOINT - defaults to ${API_BASE_URL}/api/v1/holder

# Mediator Agent
MEDIATOR_AGENT_NAME=AI-Agent-Mediator
MEDIATOR_WALLET_ID=mediator-wallet
MEDIATOR_WALLET_KEY=mediator-secure-key-change-in-production
# MEDIATOR_ENDPOINT - defaults to ${API_BASE_URL}/api/v1/mediator

# DID Configuration
DID_METHOD=key
DID_WEB_DOMAIN=localhost

# Database Configuration
# SQLite (default for development)
WALLET_STORAGE_TYPE=sqlite
WALLET_STORAGE_PATH=./data/wallets

# PostgreSQL (production - uncomment and configure)
# WALLET_STORAGE_TYPE=postgres
# DATABASE_URL=postgresql://ssi_user:ssi_password@localhost:5432/ssi_db

# Docker Compose PostgreSQL settings
POSTGRES_USER=ssi_user
POSTGRES_PASSWORD=ssi_password
POSTGRES_DB=ssi_db

# pgAdmin settings (optional)
PGADMIN_EMAIL=admin@localhost.com
PGADMIN_PASSWORD=admin123

# Client Credentials (for API auth)
WEB_WALLET_SECRET=web-wallet-secret-change-in-production
ISSUER_CLIENT_SECRET=issuer-secret-change-in-production
VERIFIER_CLIENT_SECRET=verifier-secret-change-in-production

# JWT
JWT_SECRET=jwt-secret-change-in-production-minimum-32-characters

# Keycloak SSO (optional — leave empty to disable)
# KEYCLOAK_REALM_URL=http://localhost:8080/realms/ssi
# KEYCLOAK_CLIENT_ID=ssi-backend
# KEYCLOAK_CLIENT_SECRET=ssi-backend-secret-change-in-production
# KEYCLOAK_FRONTEND_CLIENT_ID=ssi-frontend
