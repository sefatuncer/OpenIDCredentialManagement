{
  "name": "ai-agent-identity",
  "version": "1.0.0",
  "description": "AI Agent Identity System - API Gateway",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy-public",
    "copy-public": "node scripts/copy-public.js",
    "start": "node --require ./scripts/register-askar.js dist/index.js",
    "dev": "cross-env NODE_ENV=development nodemon --exec 'ts-node --require ./scripts/register-askar.js' src/index.ts",
    "test": "jest",
    "clean": "rimraf dist",
    "prebuild": "npm run clean",
    "setup": "npm install && mkdirp data logs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "swagger:generate": "ts-node -e \"const s = require('./src/api/swagger'); console.log(JSON.stringify(s.swaggerSpec, null, 2))\" > openapi.json",
    "cli": "ts-node src/cli/index.ts",
    "demo": "node scripts/demo.js"
  },
  "bin": {
    "ai-identity": "./dist/cli/index.js"
  },
  "keywords": [
    "ssi",
    "verifiable-credentials",
    "ai-agent",
    "openid4vc",
    "did"
  ],
  "license": "MIT",
  "dependencies": {
    "@credo-ts/askar": "^0.6.3",
    "@credo-ts/core": "^0.6.3",
    "@credo-ts/node": "^0.6.3",
    "@credo-ts/openid4vc": "^0.6.3",
    "@openwallet-foundation/askar-nodejs": "^0.4.3",
    "@types/compression": "^1.8.1",
    "bcrypt": "^5.1.1",
    "body-parser": "^1.20.2",
    "commander": "^11.1.0",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.11.3",
    "prom-client": "^15.1.0",
    "qrcode": "^1.5.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mkdirp": "^3.0.1",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
