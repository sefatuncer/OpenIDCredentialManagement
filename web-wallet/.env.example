# Web Wallet - Environment Configuration
# Copy this file to .env and set values for your environment

# REQUIRED: Client credentials for API authentication
# Get these from your administrator
VITE_CLIENT_ID=web-wallet
VITE_CLIENT_SECRET=  # REQUIRED: Set the client secret

# SSI Backend URL (optional - defaults to http://localhost:3000)
VITE_SSI_BACKEND_URL=http://localhost:3000

# API Base URL (optional - defaults to /api/v1)
VITE_API_URL=/api/v1
