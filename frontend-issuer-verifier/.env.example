# SSI Dashboard - Environment Configuration
# Copy this file to .env and set values for your environment

# API Base URL (optional - defaults to /api/v1)
VITE_API_BASE_URL=/api/v1

# Backend URL (optional - defaults to http://localhost:3000)
VITE_SSI_BACKEND_URL=http://localhost:3000

# Session timeout in milliseconds (optional - defaults to 30 minutes)
VITE_SESSION_TIMEOUT=1800000

# Token refresh threshold in milliseconds (optional - defaults to 5 minutes)
VITE_TOKEN_REFRESH_THRESHOLD=300000
