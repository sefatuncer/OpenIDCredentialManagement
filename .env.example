# AI Agent Identity System - Environment Configuration
# Copy this file to .env and customize for your environment
# WARNING: All values marked as REQUIRED must be set for production

# =============================================================================
# Node Environment
# =============================================================================
NODE_ENV=development
# NODE_ENV=production

# =============================================================================
# API Configuration
# =============================================================================
API_PORT=3000
HTTPS_PORT=3443
ISSUER_BASE_URL=http://localhost:3000

# =============================================================================
# Database Configuration (PostgreSQL) - REQUIRED for production
# =============================================================================
# REQUIRED: All database settings must be configured
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_identity
DB_USER=aiagent
DB_PASSWORD=  # REQUIRED: Set a strong password
DB_POOL_MAX=20
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=5000
DB_SSL=false

# Alternative: Use connection URL instead of individual parameters
# DATABASE_URL=postgresql://user:password@host:5432/database

# =============================================================================
# Redis Configuration (Optional - for caching and rate limiting)
# =============================================================================
REDIS_URL=redis://localhost:6379
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_KEY_PREFIX=ai_identity:
# REDIS_TLS=false

# =============================================================================
# Security & Authentication - REQUIRED for production
# =============================================================================
# REQUIRED: JWT Secret for API authentication (min 32 characters)
JWT_SECRET=  # REQUIRED: Generate with: openssl rand -base64 32

# REQUIRED: API Key for admin endpoints (min 32 characters)
API_KEY=  # REQUIRED: Generate with: openssl rand -base64 32

# REQUIRED: At least one client secret must be configured
WEB_WALLET_SECRET=  # REQUIRED: Generate with: openssl rand -base64 32
MOBILE_WALLET_SECRET=  # Optional
AGENT_API_SECRET=  # Optional
ISSUER_CLIENT_SECRET=  # Optional
VERIFIER_CLIENT_SECRET=  # Optional

# Credential signing secret (REQUIRED for production)
CREDENTIAL_SIGNING_SECRET=  # REQUIRED: Generate with: openssl rand -base64 32

# =============================================================================
# Wallet Configuration
# =============================================================================
WALLET_ID=ai-identity-wallet
WALLET_KEY=  # REQUIRED for production: Generate with: openssl rand -base64 32
WALLET_PATH=./data/wallets

# =============================================================================
# CORS Configuration - REQUIRED for production
# =============================================================================
# Comma-separated list of allowed origins (no wildcards in production!)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
# For production: CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com

# =============================================================================
# TLS Configuration
# =============================================================================
TLS_ENABLED=false  # Set to true for production
TLS_CERT_PATH=./docker/certs/server.crt
TLS_KEY_PATH=./docker/certs/server.key
TLS_CA_PATH=./docker/certs/ca.crt
TLS_PASSPHRASE=
TLS_MIN_VERSION=TLSv1.2
TLS_REQUEST_CERT=false
TLS_REJECT_UNAUTHORIZED=true
TLS_REDIRECT_HTTP=false

# mTLS (Mutual TLS)
MTLS_CLIENT_CERT_REQUIRED=false
MTLS_TRUSTED_CAS=

# =============================================================================
# Feature Flags
# =============================================================================
# Optional modules
FEATURE_TRUST_REGISTRY=true
FEATURE_REVOCATION=true
FEATURE_AUDIT=true
FEATURE_SDJWT=true
FEATURE_BACKUP=true
FEATURE_BATCH_ISSUANCE=true
FEATURE_MULTI_TENANT=false

# Security features
FEATURE_RATE_LIMITING=true

# Experimental features
FEATURE_FEDERATION=false
FEATURE_VERIFIED_BOT=false
FEATURE_WEBHOOKS=false

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=info
# LOG_LEVEL=debug
LOG_FORMAT=json
# LOG_FORMAT=pretty

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Docker Configuration (used by docker-compose)
# =============================================================================
POSTGRES_USER=aiagent
POSTGRES_PASSWORD=  # REQUIRED: Set a strong password
POSTGRES_DB=ai_identity
